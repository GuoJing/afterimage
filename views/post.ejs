<%- include('partials/head', { pageTitle: post.title, description }) %>
<main class="main inner post-page content-layout-page">
  <article class="post post-detail standard-content" lang="<%= post.rendered_locale %>">
    <div class="post-title-row">
      <h1><%= post.title %></h1>
      <% if (post.availableLocales.length > 1) { %>
        <nav class="post-languages" aria-label="文章语言">
          <% post.availableLocales.forEach(code => { const languagePath = `/post/${code}/${post.slug}`; %><a class="<%= code === post.rendered_locale ? 'active' : '' %>" href="/language/<%= code %>?next=<%= encodeURIComponent(languagePath) %>" <%- code === post.rendered_locale ? 'aria-current="page"' : '' %>><%= code.toUpperCase() %></a><% }) %>
        </nav>
      <% } %>
    </div>
    <div class="post-meta">
      <time datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
      <span class="meta-separator" aria-hidden="true">·</span>
      <a href="<%= authorUrl %>" rel="author"><%= post.author %></a>
      <% if (post.category) { %><span class="meta-separator" aria-hidden="true">·</span><a href="<%= topicUrl(post.category) %>"><%= post.category %></a><% } %>
    </div>
    <% if (post.status === 'draft') { %><p class="draft-preview-note">管理员草稿预览</p><% } %>
    <% if (post.rendered_locale !== locale) { %><p class="fallback-note">此文章暂时没有 <%= locale.toUpperCase() %> 版本，正在显示默认语言。</p><% } %>
    <div class="prose"><%- renderMarkdown(post.body) %></div>
    <% if (relatedPosts.length) { %>
      <aside class="related-posts" aria-labelledby="related-posts-title">
        <p class="eyebrow" id="related-posts-title"><%= seoCopy.relatedTitle %></p>
        <ul>
          <% relatedPosts.forEach(item => { %><li><a href="/post/<%= item.rendered_locale %>/<%= item.slug %>"><span><%= item.title %></span><time datetime="<%= item.published_at %>"><%= formatDate(item.published_at) %></time></a></li><% }) %>
        </ul>
      </aside>
    <% } %>
    <footer class="article-signature">
      <img src="/brand-mark.png?v=1" width="42" height="42" alt="<%= blog.title %>" loading="lazy" decoding="async">
      <p>Copyright by <%= post.author %></p>
    </footer>
  </article>
</main>
<%- include('partials/footer') %>
