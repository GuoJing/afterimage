<%- include('partials/head', { pageTitle: post.title, description: post.summary || blog.description }) %>
<main class="main inner">
  <article class="post" lang="<%= post.rendered_locale %>">
    <h1><%= post.title %></h1>
    <% if (post.rendered_locale !== locale) { %><p class="fallback-note">此文章暂时没有 <%= locale.toUpperCase() %> 版本，正在显示默认语言。</p><% } %>
    <div class="prose"><%- renderMarkdown(post.body) %></div>
    <time class="published static" datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
  </article>
  <a class="back" href="/<%= langQuery %>">← 返回首页</a>
</main>
<%- include('partials/footer') %>
