<%- include('partials/head', { pageTitle, description, previousUrl, nextUrl }) %>
<main class="archive-main">
  <div class="archive-inner">
    <section class="archive-list" aria-label="<%= archiveTitle %>">
      <% if (!posts.length) { %><p class="archive-empty"><%= locale === 'zh' ? '暂时没有已发布文章。' : locale === 'ja' ? '公開済みの記事はまだありません。' : 'No published posts yet.' %></p><% } %>
      <% posts.forEach(post => { %>
        <article class="archive-item" lang="<%= post.rendered_locale %>">
          <time datetime="<%= post.published_at %>"><%= formatDate(post.published_at) %></time>
          <div class="archive-item-content">
            <h2><a href="/post/<%= post.rendered_locale %>/<%= post.slug %>"><%= post.title %></a></h2>
            <% const excerpt = archiveExcerpt(post); if (excerpt) { %><p><%= excerpt %></p><% } %>
          </div>
        </article>
      <% }) %>
    </section>
    <% if (previousUrl || nextUrl) { %>
      <nav class="collection-pagination" aria-label="<%= paginationCopy.navigation %>">
        <span><% if (previousUrl) { %><a class="previous" rel="prev" href="<%= previousUrl %>">← <%= paginationCopy.previous %></a><% } %></span>
        <small><%= paginationCopy.page(page) %> / <%= totalPages %></small>
        <span><% if (nextUrl) { %><a class="next" rel="next" href="<%= nextUrl %>"><%= paginationCopy.next %> →</a><% } %></span>
      </nav>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
