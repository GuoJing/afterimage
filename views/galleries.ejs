<%- include('partials/head', { pageTitle: 'Collections', description }) %>
<main class="gallery-index-main">
  <section class="gallery-index" aria-labelledby="gallery-index-title">
    <header class="gallery-index-header">
      <h1 id="gallery-index-title">Collections</h1>
      <p><%= galleries.length %> <%= galleries.length === 1 ? 'collection' : 'collections' %></p>
    </header>

    <% if (!galleries.length) { %>
      <div class="gallery-index-empty">
        <span aria-hidden="true">◇</span>
        <p>No galleries yet.</p>
      </div>
    <% } else { %>
      <div class="gallery-index-grid">
        <% galleries.forEach((gallery, galleryIndex) => { const previewCount = gallery.preview_photos.length; %>
          <article class="gallery-index-card">
            <div class="gallery-index-card-body">
              <div>
                <h2><a href="/gallery/<%= encodeURIComponent(gallery.slug) %>"><%= gallery.name %></a></h2>
                <p class="gallery-index-meta">
                  <time datetime="<%= gallery.published_at %>"><%= formatDate(gallery.published_at) %></time>
                  <span class="meta-separator" aria-hidden="true">·</span>
                  <a href="/page/<%= locale %>/about" rel="author"><%= gallery.author %></a>
                  <span class="meta-separator" aria-hidden="true">·</span>
                  <span><%= gallery.photo_count %> photos</span>
                </p>
                <% if (gallery.description) { %><p class="gallery-index-description"><%= gallery.description %></p><% } %>
              </div>
              <a class="gallery-index-arrow" href="/gallery/<%= encodeURIComponent(gallery.slug) %>" aria-label="<%= gallery.name %>">↗</a>
            </div>
            <a class="gallery-index-preview gallery-index-preview-<%= previewCount %>" href="/gallery/<%= encodeURIComponent(gallery.slug) %>" aria-label="<%= gallery.name %>, <%= gallery.photo_count %> photos">
              <% if (previewCount) { %>
                <% gallery.preview_photos.forEach((photo, index) => { %>
                  <img src="<%= photo.image_url %>" alt="<%= photo.description || `${gallery.name} ${index + 1}` %>" loading="<%= galleryIndex === 0 && index === 0 ? 'eager' : 'lazy' %>" decoding="async"<%- galleryIndex === 0 && index === 0 ? ' fetchpriority="high"' : '' %>>
                <% }) %>
              <% } else { %>
                <span>EMPTY GALLERY</span>
              <% } %>
            </a>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
