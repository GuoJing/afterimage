<%- include('../partials/head', { pageTitle: isNew ? '新建 Gallery' : '编辑 Gallery', adminLayout: true }) %>
<div class="admin-layout">
  <%- include('sidebar', { adminSection: 'galleries' }) %>
  <main class="admin-content gallery-editor-page">
    <header class="admin-page-head">
      <div><p class="eyebrow">CONTENT / GALLERY</p><h1><%= isNew ? '新建 Gallery' : '编辑 Gallery' %></h1><p><%= isNew ? '先保存基本信息，然后上传照片。' : '整理照片、设置封面并拖拽调整顺序。' %></p></div>
      <div class="button-row"><% if (!isNew) { %><a class="button" target="_blank" href="/gallery/<%= gallery.slug %>">查看 Gallery ↗</a><% } %><a class="button" href="<%= adminBasePath %>/galleries">返回列表</a></div>
    </header>
    <% if (typeof saved !== 'undefined' && saved) { %><p class="form-success">Gallery 已保存</p><% } %>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <form class="gallery-editor-form" action="<%= isNew ? `${adminBasePath}/galleries` : `${adminBasePath}/galleries/${gallery.id}` %>" method="post" data-gallery-editor<% if (!isNew) { %> data-photo-upload-url="<%= adminBasePath %>/galleries/<%= gallery.id %>/photos" data-photo-delete-base="<%= adminBasePath %>/galleries/<%= gallery.id %>/photos" data-image-max-bytes="<%= imageMaxBytes %>"<% } %>>
      <input type="hidden" name="csrf" value="<%= csrf %>" data-csrf>
      <section class="admin-card gallery-details-card">
        <div class="gallery-settings-grid">
          <label>名称<input name="name" value="<%= gallery.name || '' %>" maxlength="160" required placeholder="例如 Tokyo, 2026"></label>
          <label>Gallery URL<div class="slug-input"><span>/gallery/</span><input name="slug" value="<%= gallery.slug || '' %>" placeholder="tokyo-2026" pattern="[A-Za-z0-9][A-Za-z0-9_-]*" required></div></label>
          <label>作者<input name="author" value="<%= gallery.author || 'GuoJing' %>" maxlength="100" placeholder="GuoJing"></label>
          <label>发布时间<input name="published_at" type="datetime-local" value="<%= datetimeLocalValue(gallery.published_at) %>" required></label>
          <label class="gallery-description-field">描述<textarea name="description" rows="4" maxlength="5000" placeholder="简要介绍这个 Gallery"><%= gallery.description || '' %></textarea></label>
          <label class="gallery-related-field">关联文章 URL<textarea name="related_urls" rows="4" placeholder="/post/zh/example&#10;https://example.com/article"><%= gallery.related_articles_text || '' %></textarea><small>每行一个 URL，支持 / 开头的站内地址或完整 HTTP/HTTPS 地址，最多 20 个；前台统一在新标签页打开。</small></label>
        </div>
      </section>

      <%
        const selectedTheme = gallery.theme_settings?.theme || 'masonry';
        const selectedThemeOptions = gallery.theme_settings?.options || {};
        const themeValue = (theme, key, fallback) => selectedTheme === theme && selectedThemeOptions[key] !== undefined ? selectedThemeOptions[key] : fallback;
      %>
      <section class="admin-card gallery-theme-card" data-gallery-theme-picker>
        <header class="gallery-theme-heading">
          <div><p class="eyebrow">APPEARANCE</p><h2>Gallery 皮肤</h2><p>选择详情页的图片展示方式，再调整这套皮肤专属的参数。</p></div>
          <span class="gallery-theme-badge" data-gallery-theme-badge><%= galleryThemes.find(theme => theme.id === selectedTheme)?.name || '瀑布流' %></span>
        </header>
        <div class="gallery-theme-choices">
          <% galleryThemes.forEach(theme => { %>
            <label class="gallery-theme-choice <%= selectedTheme === theme.id ? 'is-selected' : '' %>" data-gallery-theme-choice>
              <input type="radio" name="gallery_theme" value="<%= theme.id %>" <%= selectedTheme === theme.id ? 'checked' : '' %>>
              <span class="gallery-theme-preview theme-preview-<%= theme.id %>" aria-hidden="true">
                <% if (theme.id === 'fade') { %><i></i><i></i><i></i><b>01 / 04</b><% } else { %><i></i><i></i><i></i><i></i><i></i><i></i><% } %>
              </span>
              <span class="gallery-theme-copy"><strong><%= theme.name %></strong><small><%= theme.description %></small></span>
              <span class="gallery-theme-check">✓</span>
            </label>
          <% }) %>
        </div>

        <div class="gallery-theme-parameters">
          <div class="gallery-theme-panel" data-gallery-theme-panel="masonry" <%= selectedTheme === 'masonry' ? '' : 'hidden' %>>
            <header><strong>瀑布流参数</strong><span>图片保持原始比例</span></header>
            <div class="gallery-parameter-grid">
              <label>桌面列数<input type="number" name="theme_masonry_columns_desktop" min="2" max="6" value="<%= themeValue('masonry', 'columnsDesktop', 4) %>"></label>
              <label>平板列数<input type="number" name="theme_masonry_columns_tablet" min="1" max="4" value="<%= themeValue('masonry', 'columnsTablet', 3) %>"></label>
              <label>图片间距（px）<input type="number" name="theme_masonry_gap" min="0" max="48" value="<%= themeValue('masonry', 'gap', 16) %>"></label>
              <label class="gallery-switch"><input type="checkbox" name="theme_masonry_show_captions" value="1" <%= themeValue('masonry', 'showCaptions', true) ? 'checked' : '' %>><span></span>显示照片描述</label>
            </div>
          </div>

          <div class="gallery-theme-panel" data-gallery-theme-panel="grid" <%= selectedTheme === 'grid' ? '' : 'hidden' %>>
            <header><strong>平铺网格参数</strong><span>所有图片使用统一画幅</span></header>
            <div class="gallery-parameter-grid">
              <label>桌面列数<input type="number" name="theme_grid_columns_desktop" min="2" max="6" value="<%= themeValue('grid', 'columnsDesktop', 4) %>"></label>
              <label>平板列数<input type="number" name="theme_grid_columns_tablet" min="1" max="4" value="<%= themeValue('grid', 'columnsTablet', 2) %>"></label>
              <label>图片间距（px）<input type="number" name="theme_grid_gap" min="0" max="48" value="<%= themeValue('grid', 'gap', 12) %>"></label>
              <label>画幅比例<select name="theme_grid_aspect_ratio"><% [['natural','原始比例'],['1:1','正方形 1:1'],['4:3','标准 4:3'],['3:2','摄影 3:2'],['16:9','宽屏 16:9']].forEach(([value, label]) => { %><option value="<%= value %>" <%= themeValue('grid', 'aspectRatio', '3:2') === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
              <label>图片适配<select name="theme_grid_image_fit"><option value="cover" <%= themeValue('grid', 'imageFit', 'cover') === 'cover' ? 'selected' : '' %>>裁切铺满</option><option value="contain" <%= themeValue('grid', 'imageFit', 'cover') === 'contain' ? 'selected' : '' %>>完整显示</option></select></label>
            </div>
          </div>

          <div class="gallery-theme-panel" data-gallery-theme-panel="fade" <%= selectedTheme === 'fade' ? '' : 'hidden' %>>
            <header><strong>渐隐画廊参数</strong><span>单张大图平滑切换</span></header>
            <div class="gallery-parameter-grid">
              <label>停留时间（毫秒）<input type="number" name="theme_fade_interval_ms" min="2000" max="15000" step="100" value="<%= themeValue('fade', 'intervalMs', 5000) %>"></label>
              <label>渐变时间（毫秒）<input type="number" name="theme_fade_transition_ms" min="200" max="3000" step="100" value="<%= themeValue('fade', 'transitionMs', 900) %>"></label>
              <label>图片适配<select name="theme_fade_image_fit"><option value="contain" <%= themeValue('fade', 'imageFit', 'contain') === 'contain' ? 'selected' : '' %>>完整显示</option><option value="cover" <%= themeValue('fade', 'imageFit', 'contain') === 'cover' ? 'selected' : '' %>>裁切铺满</option></select></label>
              <label class="gallery-switch"><input type="checkbox" name="theme_fade_autoplay" value="1" <%= themeValue('fade', 'autoplay', true) ? 'checked' : '' %>><span></span>自动播放</label>
              <label class="gallery-switch"><input type="checkbox" name="theme_fade_show_thumbnails" value="1" <%= themeValue('fade', 'showThumbnails', true) ? 'checked' : '' %>><span></span>显示缩略图导航</label>
            </div>
          </div>

          <div class="gallery-theme-panel" data-gallery-theme-panel="justified" <%= selectedTheme === 'justified' ? '' : 'hidden' %>>
            <header><strong>智能拼接参数</strong><span>根据照片比例自动填满每一行</span></header>
            <div class="gallery-parameter-grid">
              <label>目标行高（px）<input type="number" name="theme_justified_target_row_height" min="160" max="600" value="<%= themeValue('justified', 'targetRowHeight', 320) %>"></label>
              <label>最大行高（px）<input type="number" name="theme_justified_max_row_height" min="200" max="900" value="<%= themeValue('justified', 'maxRowHeight', 480) %>"></label>
              <label>图片间距（px）<input type="number" name="theme_justified_gap" min="0" max="40" value="<%= themeValue('justified', 'gap', 10) %>"></label>
              <label>末行对齐<select name="theme_justified_last_row"><option value="left" <%= themeValue('justified', 'lastRow', 'left') === 'left' ? 'selected' : '' %>>左对齐</option><option value="center" <%= themeValue('justified', 'lastRow', 'left') === 'center' ? 'selected' : '' %>>居中</option><option value="justify" <%= themeValue('justified', 'lastRow', 'left') === 'justify' ? 'selected' : '' %>>拉伸填满</option></select></label>
              <label class="gallery-switch"><input type="checkbox" name="theme_justified_show_captions" value="1" <%= themeValue('justified', 'showCaptions', false) ? 'checked' : '' %>><span></span>显示照片描述</label>
            </div>
          </div>
        </div>
      </section>

      <% if (!isNew) { %>
        <section class="admin-card gallery-photos-card">
          <header class="gallery-photos-heading">
            <div><p class="eyebrow">PHOTOS</p><h2>照片 <span data-gallery-photo-count><%= gallery.photos.length %></span></h2><p>拖拽照片调整顺序，选择一张作为封面。</p></div>
            <label class="button primary gallery-upload-button">＋ 上传照片<input type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple data-gallery-image-input></label>
          </header>
          <p class="gallery-upload-status" data-gallery-upload-status aria-live="polite"></p>
          <label class="gallery-no-cover"><input type="radio" name="cover_photo_id" value="" <%= gallery.cover_photo_id ? '' : 'checked' %>> 不设置封面</label>
          <div class="gallery-photo-grid" data-gallery-photo-list>
            <% gallery.photos.forEach((photo, index) => { %>
              <article class="gallery-photo-card" draggable="true" data-gallery-photo data-photo-id="<%= photo.id %>">
                <input type="hidden" name="photo_id" value="<%= photo.id %>">
                <div class="gallery-photo-preview">
                  <img src="<%= photo.image_url %>" alt="<%= photo.description || `照片 ${index + 1}` %>">
                  <span class="gallery-drag-handle" aria-hidden="true">⠿</span>
                  <span class="gallery-position" data-gallery-position><%= index + 1 %></span>
                  <label class="gallery-cover-choice"><input type="radio" name="cover_photo_id" value="<%= photo.id %>" <%= Number(gallery.cover_photo_id) === photo.id ? 'checked' : '' %>> 封面</label>
                </div>
                <label>照片描述<textarea name="photo_description" rows="3" maxlength="1000" placeholder="可留空"><%= photo.description || '' %></textarea></label>
                <label>拍摄时间<input type="datetime-local" name="photo_taken_at" value="<%= datetimeLocalValue(photo.taken_at) %>"></label>
                <button class="gallery-remove-photo" type="button" data-delete-gallery-photo>移除照片</button>
              </article>
            <% }) %>
          </div>
          <div class="gallery-empty-photos" data-gallery-empty <%= gallery.photos.length ? 'hidden' : '' %>><span>◇</span><p>Gallery 还是空的，上传第一张照片吧。</p></div>
        </section>
      <% } %>

      <div class="gallery-form-actions">
        <% if (!isNew) { %><button class="danger" type="submit" form="delete-gallery" data-confirm="确定删除这个 Gallery 吗？照片记录也会一并移除。">删除 Gallery</button><% } %>
        <button class="primary" type="submit"><%= isNew ? '创建并上传照片' : '保存 Gallery' %></button>
      </div>
    </form>
    <% if (!isNew) { %><form id="delete-gallery" action="<%= adminBasePath %>/galleries/<%= gallery.id %>/delete" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"></form><% } %>
  </main>
</div>

<% if (!isNew) { %>
<template id="gallery-photo-template">
  <article class="gallery-photo-card" draggable="true" data-gallery-photo data-photo-id="">
    <input type="hidden" name="photo_id" value="">
    <div class="gallery-photo-preview">
      <img src="" alt="新上传照片">
      <span class="gallery-drag-handle" aria-hidden="true">⠿</span>
      <span class="gallery-position" data-gallery-position></span>
      <label class="gallery-cover-choice"><input type="radio" name="cover_photo_id" value=""> 封面</label>
    </div>
    <label>照片描述<textarea name="photo_description" rows="3" maxlength="1000" placeholder="可留空"></textarea></label>
    <label>拍摄时间<input type="datetime-local" name="photo_taken_at" value=""></label>
    <button class="gallery-remove-photo" type="button" data-delete-gallery-photo>移除照片</button>
  </article>
</template>
<% } %>
<%- include('../partials/footer', { adminLayout: true }) %>
