<%- include('../partials/head', { pageTitle: '导航管理', adminLayout: true }) %>
<div class="admin-layout">
  <%- include('sidebar', { adminSection: 'navigation' }) %>
  <main class="admin-content">
    <header class="admin-page-head">
      <div><p class="eyebrow">SITE</p><h1>导航管理</h1><p>设置显示在站点标题下方的全局导航。</p></div>
    </header>
    <% if (typeof saved !== 'undefined' && saved) { %><p class="form-success">导航已保存</p><% } %>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <div class="navigation-admin-layout">
      <section class="admin-card navigation-editor-card">
        <div class="navigation-card-heading"><p class="eyebrow"><%= isNew ? 'NEW ITEM' : 'EDIT ITEM' %></p><h2><%= isNew ? '新增导航' : '编辑导航' %></h2></div>
        <form action="<%= isNew ? `${adminBasePath}/navigation` : `${adminBasePath}/navigation/${navigation.id}` %>" method="post">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <label>导航名称<input name="label" value="<%= navigation.label %>" maxlength="80" placeholder="例如：关于" required></label>
          <label>URL<input name="url" value="<%= navigation.url %>" maxlength="2048" placeholder="/page/zh/about 或 https://example.com" required><small>支持站内 / 开头的地址、# 锚点或完整 HTTP/HTTPS 地址。</small></label>
          <label>打开方式<select name="target"><option value="self" <%= navigation.target === 'self' ? 'selected' : '' %>>当前页面打开</option><option value="blank" <%= navigation.target === 'blank' ? 'selected' : '' %>>新页面打开</option></select></label>
          <label>排序<input name="position" type="number" min="-9999" max="9999" step="1" value="<%= navigation.position %>" required><small>数字越小越靠前；相同数字按创建顺序排列。</small></label>
          <div class="navigation-form-actions">
            <% if (!isNew) { %><a class="button" href="<%= adminBasePath %>/navigation">取消编辑</a><% } %>
            <button class="primary" type="submit"><%= isNew ? '新增导航' : '保存导航' %></button>
          </div>
        </form>
        <% if (!isNew) { %>
          <form class="navigation-delete-form" action="<%= adminBasePath %>/navigation/<%= navigation.id %>/delete" method="post">
            <input type="hidden" name="csrf" value="<%= csrf %>">
            <button class="danger" type="submit" data-confirm="确定删除这个导航吗？">删除导航</button>
          </form>
        <% } %>
      </section>

      <section class="admin-card navigation-list-card">
        <div class="navigation-card-heading"><p class="eyebrow">GLOBAL NAVIGATION</p><h2>当前导航</h2></div>
        <% if (!items.length) { %><div class="navigation-empty"><span>☷</span><p>还没有导航，新增后会立即显示在全站标题下方。</p></div><% } %>
        <div class="navigation-list">
          <% items.forEach(item => { %>
            <a class="navigation-item <%= !isNew && item.id === navigation.id ? 'active' : '' %>" href="<%= adminBasePath %>/navigation/<%= item.id %>/edit">
              <span class="navigation-position"><%= item.position %></span>
              <span class="navigation-item-copy"><strong><%= item.label %></strong><small><%= item.url %></small></span>
              <span class="navigation-target"><%= item.target === 'blank' ? '新页面 ↗' : '当前页面' %></span>
              <b>›</b>
            </a>
          <% }) %>
        </div>
      </section>
    </div>
  </main>
</div>
<%- include('../partials/footer', { adminLayout: true }) %>
