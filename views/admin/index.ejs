<%- include('../partials/head', { pageTitle: '文章', adminLayout: true }) %>
<div class="admin-layout">
  <%- include('sidebar', { adminSection: 'posts' }) %>
  <main class="admin-content">
    <header class="admin-page-head">
      <div><p class="eyebrow">CONTENT</p><h1>文章列表</h1><p>管理草稿、已发布文章及其语言版本。</p></div>
      <a class="button primary" href="<%= adminBasePath %>/posts/new">＋ 新建文章</a>
    </header>
    <section class="admin-card post-list">
      <% if (!posts.length) { %><div class="admin-empty"><span>◇</span><h2>还没有文章</h2><p>从一篇新文章开始。</p><a class="button primary" href="<%= adminBasePath %>/posts/new">新建文章</a></div><% } %>
      <% posts.forEach(post => { %>
        <div class="admin-post admin-post-with-action">
          <a class="admin-post-main" href="<%= adminBasePath %>/posts/<%= post.id %>/edit">
            <span class="admin-post-copy"><strong><%= post.title %></strong><small><%= post.slug %></small></span>
            <span class="admin-post-meta"><%= post.translation_locales || '—' %><em class="status <%= post.status %>"><%= post.status === 'published' ? '已发布' : '草稿' %></em></span>
          </a>
          <a class="button admin-delivery-link" href="<%= adminBasePath %>/posts/<%= post.id %>/delivery"><span>推送</span><small><%= post.sent_count %>/<%= post.subscriber_count %></small></a>
        </div>
      <% }) %>
    </section>
  </main>
</div>
<%- include('../partials/footer', { adminLayout: true }) %>
