<%
  const resolvedDescription = typeof description !== 'undefined' && description ? description : blog.description;
  const resolvedTitle = typeof documentTitle !== 'undefined' && documentTitle
    ? documentTitle
    : typeof pageTitle !== 'undefined' && pageTitle ? `${pageTitle} | ${blog.title}` : blog.title;
  const resolvedCanonical = typeof canonicalUrl !== 'undefined' ? canonicalUrl : siteUrl;
  const resolvedRobots = typeof robots !== 'undefined' ? robots : 'index, follow';
  const resolvedOgType = typeof ogType !== 'undefined' ? ogType : 'website';
  const resolvedOgImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : siteImageUrl;
  const resolvedLang = typeof htmlLang !== 'undefined' && htmlLang ? htmlLang : locale;
%>
<!doctype html>
<html lang="<%= resolvedLang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= resolvedDescription %>">
  <% if (typeof authorName !== 'undefined' && authorName) { %><meta name="author" content="<%= authorName %>"><% } %>
  <meta name="robots" content="<%= resolvedRobots %>">
  <title><%= resolvedTitle %></title>
  <link rel="icon" href="/favicon.ico" sizes="50x50">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="<%= blog.title %> RSS (<%= resolvedLang %>)" href="<%= feedUrl %>">
  <link rel="canonical" href="<%= resolvedCanonical %>">
  <% if (typeof previousUrl !== 'undefined' && previousUrl) { %><link rel="prev" href="<%= previousUrl %>"><% } %>
  <% if (typeof nextUrl !== 'undefined' && nextUrl) { %><link rel="next" href="<%= nextUrl %>"><% } %>
  <% if (typeof alternateUrls !== 'undefined') { alternateUrls.forEach(item => { %><link rel="alternate" hreflang="<%= item.locale %>" href="<%= item.url %>">
  <% }) } %>
  <% if (typeof xDefaultUrl !== 'undefined' && xDefaultUrl) { %><link rel="alternate" hreflang="x-default" href="<%= xDefaultUrl %>"><% } %>
  <% if (typeof markdownUrl !== 'undefined' && markdownUrl) { %><link rel="alternate" type="text/markdown" href="<%= markdownUrl %>"><% } %>
  <link rel="describedby" type="text/plain" href="/llms.txt">
  <meta property="og:site_name" content="<%= blog.title %>">
  <meta property="og:type" content="<%= resolvedOgType %>">
  <meta property="og:title" content="<%= resolvedTitle %>">
  <meta property="og:description" content="<%= resolvedDescription %>">
  <meta property="og:url" content="<%= resolvedCanonical %>">
  <meta property="og:image" content="<%= resolvedOgImage %>">
  <meta property="og:image:alt" content="<%= typeof ogImageAlt !== 'undefined' && ogImageAlt ? ogImageAlt : resolvedTitle %>">
  <meta property="og:locale" content="<%= resolvedLang.replaceAll('-', '_') %>">
  <% if (typeof alternateUrls !== 'undefined') { alternateUrls.filter(item => item.locale !== resolvedLang).forEach(item => { %><meta property="og:locale:alternate" content="<%= item.locale.replaceAll('-', '_') %>">
  <% }) } %>
  <% if (typeof publishedAt !== 'undefined' && publishedAt) { %><meta property="article:published_time" content="<%= publishedAt %>"><% } %>
  <% if (typeof modifiedAt !== 'undefined' && modifiedAt) { %><meta property="article:modified_time" content="<%= modifiedAt %>"><% } %>
  <% if (typeof articleAuthorUrl !== 'undefined' && articleAuthorUrl) { %><meta property="article:author" content="<%= articleAuthorUrl %>"><% } %>
  <% if (typeof articleSection !== 'undefined' && articleSection) { %><meta property="article:section" content="<%= articleSection %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= resolvedTitle %>">
  <meta name="twitter:description" content="<%= resolvedDescription %>">
  <meta name="twitter:image" content="<%= resolvedOgImage %>">
  <meta name="twitter:image:alt" content="<%= typeof ogImageAlt !== 'undefined' && ogImageAlt ? ogImageAlt : resolvedTitle %>">
  <% if (typeof structuredData !== 'undefined' && structuredData) { %><script type="application/ld+json"><%- serializeJsonLd(structuredData) %></script><% } %>
  <link rel="stylesheet" href="/style.css?v=56">
  <script>try{const saved=localStorage.getItem('theme');document.documentElement.dataset.theme=saved==='dark'||saved==='light'?saved:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch(e){document.documentElement.dataset.theme='light'}</script>
</head>
<body class="<%= typeof adminLayout !== 'undefined' && adminLayout ? 'is-admin' : '' %>">
<% if (!(typeof adminLayout !== 'undefined' && adminLayout)) { %>
<header class="site-head">
  <div class="head-inner">
    <a class="logo" href="/<%= langQuery %>"><img src="/apple-touch-icon.png" width="30" height="30" alt=""><span><%= blog.title %></span></a>
    <div class="head-actions">
      <a class="account-link <%= currentUser ? 'has-avatar' : '' %>" href="<%= accountUrl %>">
        <% if (currentUser) { %>
          <span class="account-link-avatar" aria-hidden="true">
            <% if (currentUser.avatar_url) { %><img src="<%= currentUser.avatar_url %>" width="28" height="28" alt=""><% } else { %><%= Array.from(currentUser.nickname.trim())[0]?.toUpperCase() || currentUser.username[0].toUpperCase() %><% } %>
          </span>
        <% } %>
        <span class="account-link-name"><%= currentUser ? currentUser.nickname : accountLabel %></span>
      </a>
      <details class="language-menu">
        <summary aria-label="选择语言"><%= locale.toUpperCase() %></summary>
        <div class="language-popover">
          <% locales.forEach(item => { %>
            <a class="<%= item.code === locale ? 'active' : '' %>" href="/language/<%= item.code %>?next=<%= encodeURIComponent(languageSwitchPath) %>"><%= item.name %></a>
          <% }) %>
        </div>
      </details>
      <button class="theme-button" type="button" data-theme-toggle aria-label="切换明暗主题" aria-pressed="false">
        <span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span>
      </button>
    </div>
  </div>
</header>
<% if (navigationItems.length) { %>
<nav class="site-navigation" aria-label="全站导航">
  <div class="site-navigation-inner">
    <% navigationItems.forEach(item => { const isCurrentNavigation = isNavigationActive(item.url, currentPath); %>
      <a class="<%= isCurrentNavigation ? 'active' : '' %>" href="<%= item.url %>"<%- item.target === 'blank' ? ' target="_blank" rel="noopener noreferrer"' : '' %><%- isCurrentNavigation ? ' aria-current="page"' : '' %>><%= item.label %></a>
    <% }) %>
  </div>
</nav>
<% } %>
<% } %>
