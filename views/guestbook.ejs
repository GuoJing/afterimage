<%- include('partials/head', { documentTitle, description, canonicalUrl, alternateUrls, xDefaultUrl, previousUrl, nextUrl }) %>
<main class="guestbook-main">
  <section class="guestbook-inner" aria-labelledby="guestbook-title">
    <header class="guestbook-header">
      <div><h1 id="guestbook-title"><%= copy.title %></h1><p><%= copy.description %></p></div>
      <span><%= copy.count(totalMessages) %></span>
    </header>

    <% if (!messages.length) { %>
      <p class="guestbook-empty"><%= copy.empty %></p>
    <% } else { %>
      <ol class="guestbook-list">
        <% messages.forEach(message => { %>
          <li class="guestbook-message">
            <span class="guestbook-avatar <%= message.user_id ? 'member' : 'anonymous' %>" aria-hidden="true">
              <% if (message.user_id && message.avatar_url) { %><img src="<%= message.avatar_url %>" width="46" height="46" alt=""><% } else { %><%= Array.from(message.author_name.trim())[0]?.toUpperCase() || '?' %><% } %>
            </span>
            <div class="guestbook-message-body">
              <header><strong><%= message.author_name %></strong><time datetime="<%= new Date(message.submitted_at).toISOString() %>"><%= message.submitted_at_display %></time></header>
              <p><%= message.content %></p>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } %>

    <% if (previousUrl || nextUrl) { %>
      <nav class="guestbook-pagination" aria-label="<%= copy.title %>">
        <% if (previousUrl) { %><a href="<%= previousUrl %>">← <%= copy.previous %></a><% } %>
        <span><%= copy.page(page) %> / <%= totalPages %></span>
        <% if (nextUrl) { %><a class="next" href="<%= nextUrl %>"><%= copy.next %> →</a><% } %>
      </nav>
    <% } %>

    <section class="guestbook-form-section" aria-labelledby="guestbook-form-title">
      <div class="guestbook-form-heading"><p class="eyebrow">MESSAGE</p><h2 id="guestbook-form-title"><%= copy.formTitle %></h2><% if (currentUser) { %><p><%= copy.signedInAs(currentUser.nickname) %></p><% } %></div>
      <% if (submitted) { %><p class="form-success"><%= copy.submitted %></p><% } %>
      <% if (error) { %><p class="form-error"><%= error %></p><% } %>
      <form class="guestbook-form" action="<%= formAction %>" method="post">
        <input type="hidden" name="csrf" value="<%= guestbookCsrf %>">
        <% if (!currentUser) { %>
          <label><span><%= copy.author %></span><input name="author_name" value="<%= fields.author_name %>" maxlength="<%= limits.author %>" placeholder="<%= copy.authorPlaceholder %>" autocomplete="nickname" required></label>
        <% } %>
        <label><span><%= copy.content %></span><textarea name="content" maxlength="<%= limits.content %>" placeholder="<%= copy.contentPlaceholder %>" rows="6" required><%= fields.content %></textarea></label>
        <div class="guestbook-submit"><button class="primary" type="submit"><%= copy.submit %></button></div>
      </form>
    </section>
  </section>
</main>
<%- include('partials/footer') %>
