PORT=3000
SITE_URL=https://afterimage.photography
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-a-random-secret
BLOG_TITLE=AFTERIMAGE PHOTOGRAPHY
BLOG_AUTHOR=GuoJing
BLOG_DESCRIPTION=一个关于摄影、观看与生活的个人博客。
# BLOG_SOCIAL_URLS=https://www.instagram.com/your-account,https://www.youtube.com/@your-channel
BLOG_LOCALES=zh,en,ja
DEFAULT_LOCALE=zh
# Optional localized homepage SEO copy:
# HOME_SEO_TITLE_ZH=AFTERIMAGE PHOTOGRAPHY — 摄影作品、摄影写作与视觉文化
# HOME_SEO_DESCRIPTION_ZH=站点的中文搜索摘要
# HOME_INTRO_ZH=显示在首页底部的中文站点介绍
# English and Japanese use the suffixes _EN and _JA.
# Optional; defaults to ./data/blog.db
# DATABASE_PATH=/app/data/blog.db
# Use local or spaces. IMAGE_PREFIX is an arbitrary folder namespace for this deployment.
IMAGE_STORAGE=local
IMAGE_PREFIX=library
# On a direct server deployment, an absolute path is recommended:
# IMAGE_UPLOAD_DIR=/opt/afterimage/data/uploads
IMAGE_PUBLIC_PATH=/uploads
IMAGE_MAX_SIZE_MB=15
# Required only when IMAGE_STORAGE=spaces:
# SPACES_REGION=sgp1
# SPACES_BUCKET=your-space-name
# SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
# SPACES_PUBLIC_URL=https://your-space-name.sgp1.cdn.digitaloceanspaces.com
# SPACES_ACCESS_KEY=replace-with-a-limited-access-key
# SPACES_SECRET_KEY=replace-with-the-secret-key
# Fastmail SMTP. Enable only after creating an app password in Fastmail.
MAIL_ENABLED=0
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_AUTH_METHOD=PLAIN
# DigitalOcean Droplet alternative (Fastmail TLS proxy avoids blocked SMTP ports):
# SMTP_HOST=smtps-proxy.fastmail.com
# SMTP_PORT=443
# SMTP_SECURE=1
# SMTP_USER=you@example.com
# SMTP_PASSWORD=replace-with-a-fastmail-app-password
# MAIL_FROM_ADDRESS=you@example.com
MAIL_FROM_NAME=AFTERIMAGE PHOTOGRAPHY
# MAIL_REPLY_TO=you@example.com
# Required for Admin two-step login. This address is never sent to the browser.
# ADMIN_2FA_EMAIL=private-admin@example.com
# Optional; receives a private review link whenever a member registers.
# Defaults to ADMIN_2FA_EMAIL when omitted.
# MEMBER_REGISTRATION_NOTIFY_EMAIL=private-admin@example.com
# Set to 1 when HTTPS is terminated by your reverse proxy.
TRUST_PROXY=0
